<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

<!-- ① 인자 선언: launch나 CLI에서 값을 바꿔 넣을 수 있는 변수 -->
  <xacro:arg name="name"      default="ur5e"/>
  <xacro:arg name="ur_type"   default="ur5e"/>
  <xacro:arg name="tf_prefix" default=""/>

  <!-- ② UR 팔 매크로 가져오기 (underlay ur_ws의 ur_description) -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find arm_description)/urdf/arm_study.ros2_control.xacro"/>

<link name="finger1_link">
  <visual>
    <geometry>
      <box size="0.01 0.01 0.05"/>
    </geometry>
  </visual>
  <collision>
    <geometry>
      <box size="0.01 0.01 0.05"/>
    </geometry>
  </collision>
  <inertial>
    <mass value="0.05"/>
    <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
  </inertial>
</link>

<link name="finger2_link">
  <visual>
    <geometry>
      <box size="0.01 0.01 0.05"/>
    </geometry>
  </visual>
  <collision>
    <geometry>
      <box size="0.01 0.01 0.05"/>
    </geometry>
  </collision>
  <inertial>
    <mass value="0.05"/>
    <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
  </inertial>
</link>


<joint name="finger1_joint" type="prismatic">
  <parent link="tool0"/>
  <child link="finger1_link"/>
  <origin xyz="0 0.02 0.05" rpy="0 0 0"/>
  <axis xyz="0 1 0"/>
  <limit lower="0.0" upper="0.04" effort="20" velocity="0.1"/>
</joint>

<joint name="finger2_joint" type="prismatic">
  <parent link="tool0"/>
  <child link="finger2_link"/>
  <origin xyz="0 -0.02 0.05" rpy="0 0 0"/>
  <axis xyz="0 1 0"/>
  <limit lower="0.0" upper="0.04" effort="20" velocity="0.1"/>
</joint>

</robot>