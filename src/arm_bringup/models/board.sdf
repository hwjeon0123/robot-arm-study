<?xml version="1.0"?>
<sdf version="1.9">
  <!-- 픽업용 임시 대상물. 기판(PCB)라고 가정한 얇은 판.
       크기: 그리퍼 최대 개방폭(0.05m)보다 좁은 0.02m(y)로 잡아 여유를 둠.
       질량이 아주 작아서 손가락 effort(20N) 대비 마찰만으로 충분히 붙잡힘. -->
  <model name="board">
    <!-- pose 속성은 ros_gz_sim create에서 이 파일을 넘겨주는 방식으로 사용하는 경우
      영항을 미치지 않는다. Launch에서 ros_gz_sim create를 호출할 때 -x/-y/-z/-R/-P/-Y
     옵션으로 위치와 자세를 지정해 주어야 한다. -->
    <pose>0.4 0.6 0.0025 0 0 0</pose>
    <link name="board_link">
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>7.08e-7</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.71e-6</iyy>
          <iyz>0</iyz>
          <izz>3.33e-6</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry>
          <box><size>0.04 0.02 0.005</size></box>
        </geometry>
        <material>
          <ambient>0.1 0.6 0.1 1</ambient>
          <diffuse>0.1 0.6 0.1 1</diffuse>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box><size>0.04 0.02 0.005</size></box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
