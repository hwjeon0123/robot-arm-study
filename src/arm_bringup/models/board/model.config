<?xml version="1.0"?>
<!-- 이 파일이 있어야 Gazebo 가 이 디렉토리를 모델로 인식한다.
     SDF 안의 model://board/... URI 도 이걸 기준으로 해석된다. -->
<model>
  <name>board</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <description>
    ArUco 마커를 붙인 픽업 대상물. PCB 를 올린 캐리어 플레이트로 가정한다.
  </description>
</model>
