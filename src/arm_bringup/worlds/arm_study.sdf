<?xml version="1.0" ?>
<!--
  gz-sim8 이 제공하는 default.sdf 를 바탕으로 만든 작업용 월드.

  원본과의 차이는 시스템 플러그인을 명시했다는 점 하나다.
  원본은 <plugin> 을 하나도 적지 않아서, Gazebo 가 server.config 에 정의된
  기본 세트(Physics / UserCommands / SceneBroadcaster)를 대신 올린다.
  그 기본 세트에는 센서를 처리하는 Sensors 가 없어서, 카메라를 모델에 붙여도
  이미지를 만들어 주는 주체가 없다.

  주의 — 플러그인을 하나라도 명시하면 기본 세트는 올라오지 않는다.
  Sensors 만 적으면 물리 계산조차 사라지므로 필요한 것을 모두 적어야 한다.
-->
<sdf version="1.9">
  <world name="default">

    <!-- 물리 계산. 없으면 로봇이 중력도 충돌도 받지 않는다. -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <!-- 스폰/삭제 등 외부 명령 처리. 로봇과 보드를 create 로 띄우므로 필요하다. -->
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <!-- 시뮬레이션 공간의 실시간 변화를 GUI 화면으로 전송. 이 플러그인이 없으면 3D 화면에 아무것도 표시되지 않는다. -->
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- 카메라 등 센서를 처리해 이미지를 생성한다. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
